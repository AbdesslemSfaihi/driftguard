# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Shared secret configured on the GitHub webhook settings page.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=dev-only-secret

# Where the SQLite database lives (created automatically).
DATABASE_PATH=data/driftguard.db

# --- agent credentials (each stage degrades gracefully without its key) ---
# GITHUB_TOKEN=            # fine-grained PAT (contents: read/write, pull requests: write)
# ANTHROPIC_API_KEY=       # Claude judge + fixer; empty = stop after fact extraction
# JUDGE_MODEL=claude-sonnet-5   # measured best on asking; claude-haiku-4-5 is cheaper and equal on plain judgment
# MAX_FIX_ATTEMPTS=2       # fixer retries per finding before it is dropped
# OPEN_DOCS_PRS=true       # false = store verified proposals, never push/PR

# --- ask-the-developer (human in the loop) ---
# ASK_DEVELOPER=true       # false = store questions in SQLite, never comment on the PR
# MAX_QUESTIONS_PER_RUN=3  # politeness cap per merged PR; extra questions are dropped and logged

# --- documentation index (local Ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text

# --- notifications: one JSON event per finished run, consumed by n8n (docs/n8n-notifications.md) ---
# NOTIFY_WEBHOOK_URL=      # empty = off. n8n production URL, e.g. http://localhost:5678/webhook/driftguard
# NOTIFY_WEBHOOK_TOKEN=    # sent as X-DriftGuard-Token; n8n's Webhook node verifies it (Header Auth)
# PUBLIC_BASE_URL=http://localhost:8000   # base for the story-page links inside events
