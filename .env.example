# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Shared secret configured on the GitHub webhook settings page.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=dev-only-secret

# Where the SQLite database lives (created automatically).
DATABASE_PATH=data/driftguard.db

# --- agent credentials (each stage degrades gracefully without its key) ---
# GITHUB_TOKEN=            # fine-grained PAT (contents: read/write, pull requests: write)
# ANTHROPIC_API_KEY=       # Claude judge + fixer; empty = stop after fact extraction
# JUDGE_MODEL=claude-opus-5
# MAX_FIX_ATTEMPTS=2       # fixer retries per finding before it is dropped
# OPEN_DOCS_PRS=true       # false = store verified proposals, never push/PR
